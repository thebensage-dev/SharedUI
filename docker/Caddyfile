# Coolify's proxy handles TLS and the domain.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	# SAMEORIGIN, not DENY: Storybook shows stories in its own iframe.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Kept out of search results; the portfolio site (thebensage.com) is the one to index.
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Vite's hashed bundles never change; everything else revalidates.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/*
	header @other Cache-Control "no-cache"
}
